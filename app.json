{
  "expo": {
    "name": "iaLingo",
    "slug": "ialingo",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ialingo",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.binnicordova.ialingo",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6C4BF4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.binnicordova.ialingo",
      "versionCode": 2
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6C4BF4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "iaLingo uses the microphone only while your child practices speaking. Speech is recognized on this device; nothing is uploaded, and voice diary recordings are saved only if a grown-up turns them on.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "iaLingo uses the microphone only while your child practices speaking. Speech is recognized on this device; nothing is uploaded, and voice diary recordings are saved only if a grown-up turns them on.",
          "speechRecognitionPermission": "iaLingo recognizes your child's spoken English on this device so it can give friendly pronunciation feedback. Audio is not stored or shared.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Learn English with magical pets. No login, no ads, no data collection: everything stays on the device."
  }
}